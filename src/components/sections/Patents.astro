---
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Patent {
  title: string;
  number: string;
  status: 'Published' | 'Granted';
  date: string;
  note: string;
  href: string;
  relatedHref?: string;
}

const patents: Patent[] = [
  {
    title: 'System and Methods of Segmenting Vessels from Medical Imaging Data',
    number: 'US 10102633',
    status: 'Granted',
    date: '2018-10-16',
    note: 'Medical imaging segmentation work.',
    href: 'https://patents.google.com/patent/US10102633B2/en',
  },
  {
    title: 'Custom Wake Phrase Training',
    number: 'US 20210050003',
    status: 'Published',
    date: '2021-02-18',
    note: 'Filed while leading the ML team at SoundHound.',
    href: 'https://patents.google.com/patent/US20210050003A1/en',
  },
  {
    title: 'Server-Supported Recognition of Wake Phrases',
    number: 'US 12051403',
    status: 'Granted',
    date: '2024-07-30',
    note: 'Filed while leading the ML team at SoundHound.',
    href: 'https://patents.google.com/patent/US12051403B2/en',
  },
  {
    title: 'Machine Learning and Language Model-Assisted Geospatial Data Analysis and Visualization',
    number: 'US 12625901',
    status: 'Granted',
    date: '2026-05-12',
    note: 'From the wind-siting system built as a Forward Deployed Engineer at Palantir.',
    href: 'https://patents.google.com/patent/US12625901B2/en',
    relatedHref: '/work/geospatial-wind-siting-ml/',
  },
];
---

<section id="patents" class="scroll-mt-16 px-6 py-20 sm:px-10 lg:py-28 max-w-3xl">
  <SectionHeading index="05" title="Patents" />

  <div class="space-y-4">
    {patents.map((patent) => (
      <a
        href={patent.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group block rounded-lg border border-border bg-bg-elevated p-6 transition-colors hover:border-border-hover hover:bg-bg-elevated-hover"
      >
        <div class="flex flex-wrap items-center gap-3">
          <p class="font-mono text-xs text-fg-subtle">{patent.number}</p>
          <span class="font-mono text-[0.65rem] uppercase tracking-wide text-accent border border-accent-dim rounded px-2 py-0.5">
            {patent.status}
          </span>
          <p class="font-mono text-xs text-fg-subtle">{patent.date}</p>
        </div>

        <h3 class="mt-3 text-lg font-semibold text-fg group-hover:text-accent-bright transition-colors">
          {patent.title}
        </h3>

        <p class="mt-2 text-sm text-fg-muted">{patent.note}</p>

        {patent.relatedHref && (
          <span class="mt-3 inline-block text-sm text-accent">
            View related case study &rarr;
          </span>
        )}
      </a>
    ))}
  </div>
</section>
