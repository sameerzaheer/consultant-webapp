---
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CaseStudyCard from '@/components/ui/CaseStudyCard.astro';

const foundryWork = (await getCollection('caseStudies', ({ data }) => data.category === 'foundry')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="foundry" class="scroll-mt-16 px-6 py-20 sm:px-10 lg:py-28 max-w-3xl">
  <SectionHeading index="03" title="Palantir Foundry Work" />
  <p class="-mt-6 mb-10 max-w-xl text-fg-muted">
    Time as a Forward Deployed Engineer at Palantir, building directly on the
    Foundry platform — a specialization within the broader consulting work
    above.
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    {foundryWork.map((entry) => (
      <CaseStudyCard entry={entry} />
    ))}
  </div>
</section>
