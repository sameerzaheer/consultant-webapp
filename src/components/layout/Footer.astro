---

<footer class="border-t border-border">
  <div class="lg:ml-[22rem] xl:ml-[26rem] px-6 sm:px-10 py-10 max-w-3xl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <p class="font-mono text-xs text-fg-subtle">
        &copy; {year} Sameer Zaheer &mdash; <a href="/#contact" class="hover:text-accent-bright transition-colors">Let's talk</a>
      </p>
      <div class="flex items-center gap-5">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="text-fg-muted hover:text-accent-bright transition-colors"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={social.icon}/></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
