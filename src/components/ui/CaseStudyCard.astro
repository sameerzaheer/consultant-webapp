---
import type { CollectionEntry } from 'astro:content';
import TechTag from '@/components/ui/TechTag.astro';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { title, client, clientUrl, heroMetric, techStack, platform } = entry.data;
---

<a
  href={`/work/${entry.slug}/`}
  class="group block rounded-lg border border-border bg-bg-elevated p-6 transition-colors hover:border-border-hover hover:bg-bg-elevated-hover"
>
  <div class="flex items-start justify-between gap-4">
    <p class="flex items-center gap-1.5 font-mono text-xs text-fg-subtle group-hover:text-accent transition-colors">
      {client}
      {clientUrl && (
        <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7" /><path d="M7 7h10v10" />
        </svg>
      )}
    </p>
    {platform && (
      <span class="shrink-0 font-mono text-[0.65rem] uppercase tracking-wide text-accent border border-accent-dim rounded px-2 py-0.5">
        Built on {platform}
      </span>
    )}
  </div>

  <h3 class="mt-3 text-lg font-semibold text-fg group-hover:text-accent-bright transition-colors">
    {title}
  </h3>

  <p class="mt-2 text-sm text-accent">{heroMetric}</p>

  <ul class="mt-4 flex flex-wrap gap-2">
    {techStack.map((tech) => (
      <li><TechTag>{tech}</TechTag></li>
    ))}
  </ul>
</a>
