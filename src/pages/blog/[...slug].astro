---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | AutomateThis`} description={post.data.description}>
  <article class="px-6 py-20 sm:px-10 lg:py-28 max-w-2xl">
    <a href="/blog/" class="font-mono text-xs text-fg-subtle hover:text-accent-bright transition-colors">
      &larr; Back to blog
    </a>

    <time datetime={post.data.publishDate.toISOString()} class="mt-6 block font-mono text-xs text-fg-subtle">
      {post.data.publishDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <h1 class="mt-2 text-3xl font-semibold text-fg sm:text-4xl">{post.data.title}</h1>
    <p class="mt-3 text-lg text-fg-muted">{post.data.description}</p>

    <div class="prose mt-10 max-w-none">
      <Content />
    </div>
  </article>
</Layout>
