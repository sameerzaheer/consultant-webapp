---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | AutomateThis.ca`} description={post.data.description}>
  <article class="pt-24 pb-16">
    <header class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 text-white py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <a href="/blog/" class="text-blue-400 hover:text-blue-300 text-sm mb-4 inline-block">
          ← Back to Blog
        </a>
        <time datetime={post.data.pubDate.toISOString()} class="text-gray-400 text-sm block">
          {post.data.pubDate.toLocaleDateString('en-CA', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <h1 class="text-4xl sm:text-5xl font-bold mt-4">{post.data.title}</h1>
        <p class="text-xl text-gray-300 mt-4">{post.data.description}</p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 prose prose-lg max-w-none">
      {post.data.image && (
        <img src={post.data.image} alt="" class="rounded-xl mb-8 w-full" />
      )}
      <Content />
    </div>
  </article>
</BaseLayout>
