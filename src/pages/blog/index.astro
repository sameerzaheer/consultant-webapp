---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TechTag from '@/components/ui/TechTag.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="Blog | AutomateThis" description="Notes on production AI/ML systems from Sameer Zaheer.">
  <section class="px-6 py-20 sm:px-10 lg:py-28 max-w-2xl">
    <h1 class="text-3xl font-semibold text-fg sm:text-4xl">Blog</h1>
    <p class="mt-3 text-fg-muted">Notes on shipping production AI/ML systems.</p>

    {posts.length === 0 ? (
      <div class="mt-12 rounded-lg border border-border bg-bg-elevated p-6">
        <p class="text-fg">No posts yet.</p>
        <p class="mt-2 text-sm text-fg-muted">
          Add MDX files to <code class="font-mono text-xs text-fg bg-bg px-1.5 py-0.5 rounded">src/content/blog/</code> to publish articles.
        </p>
      </div>
    ) : (
      <ul class="mt-12 space-y-6">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class="group block rounded-lg border border-border bg-bg-elevated p-6 transition-colors hover:border-border-hover hover:bg-bg-elevated-hover"
            >
              <time datetime={post.data.publishDate.toISOString()} class="font-mono text-xs text-fg-subtle">
                {post.data.publishDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="mt-2 text-xl font-semibold text-fg group-hover:text-accent-bright transition-colors">
                {post.data.title}
              </h2>
              <p class="mt-2 text-fg-muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li><TechTag>{tag}</TechTag></li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
