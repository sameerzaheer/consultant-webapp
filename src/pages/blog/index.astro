---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog | AutomateThis.ca"
  description="Insights on strategic consulting, digital transformation, and business optimization from Sameer Zaheer."
>
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">
        <span class="text-blue-400">Blog</span>
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Insights on consulting, transformation, and building better organizations.
      </p>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-br from-slate-50 via-blue-50 to-purple-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <div class="text-center py-12 bg-white/80 rounded-xl border border-white/40 shadow-lg">
          <p class="text-gray-600 text-lg mb-2">No posts yet.</p>
          <p class="text-gray-500 text-sm">
            Add MDX files to <code class="bg-gray-100 px-2 py-1 rounded">src/content/blog/</code> to publish articles.
          </p>
        </div>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="block bg-white/80 rounded-xl border border-white/40 shadow-lg p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
              >
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-blue-600">
                  {post.data.pubDate.toLocaleDateString('en-CA', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h2 class="text-2xl font-bold text-gray-900 mt-2">{post.data.title}</h2>
                <p class="text-gray-600 mt-2">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
